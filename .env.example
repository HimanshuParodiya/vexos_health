# Copy to .env and adjust.
# Leave empty so requests go through the Vite dev proxy (avoids the backend's self-signed TLS
# certificate in the browser), or set the full API origin, e.g. https://44.214.112.234
VITE_API_BASE_URL=
# Where the dev proxy forwards /api, /health, /ready and /openapi.json (including the vitals WebSocket).
VITE_BACKEND_TARGET=https://44.214.112.234
# true = fake login with demo accounts (dashboards still call the real API). Keep false against the live backend.
VITE_USE_MOCK_API=false
# Prefilled on the login form.
VITE_DEV_USERNAME=frontend_dev
# Fallback customer branding until GET /api/v1/hospital responds.
VITE_ORG_NAME=City Care Hospital
VITE_ORG_LOGO_URL=
